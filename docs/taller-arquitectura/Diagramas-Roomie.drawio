        </mxCell>
        <mxCell id="n78" value="Una tarea puede no tener responsable; una reserva sí necesita uno." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontStyle=0;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="652" width="815" height="21.6" as="geometry" />
        </mxCell>
        <mxCell id="n79" value="TaskHistory guarda cada cambio de estado en una fila separada." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontStyle=0;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="675" width="815" height="21.6" as="geometry" />
        </mxCell>
        <mxCell id="n80" value="Un recurso puede tener varias reservas, pero no horarios activos cruzados." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontStyle=0;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="698" width="815" height="21.6" as="geometry" />
        </mxCell>
        <mxCell id="n81" value="Las reservas canceladas se conservan para mantener el historial." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontStyle=0;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="721" width="815" height="21.6" as="geometry" />
        </mxCell>
        <mxCell id="n82" value="Membership 1 -- ref -- 0..* Reservation (membership_id)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontStyle=0;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="744" width="815" height="21.6" as="geometry" />
        </mxCell>
        <mxCell id="n83" value="Toda relación es ref. Un ref obligatorio apunta a 1 registro; un ref opcional apunta a 0..1." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=10;fontStyle=0;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="846" width="1170" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="n84" value="Desde el destino pueden existir 0..* registros que lo referencien, salvo las restricciones indicadas." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=10;fontStyle=0;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="862" width="1170" height="18.0" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
