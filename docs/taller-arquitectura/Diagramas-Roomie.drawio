        <mxCell id="n80" value="User y Home tienen una relación N-M resuelta con Membership." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontStyle=0;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="470" y="711" width="750" height="21.6" as="geometry" />
        </mxCell>
        <mxCell id="n81" value="UNIQUE(home_id, user_id) evita repetir una membresía." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontStyle=0;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="470" y="733" width="750" height="21.6" as="geometry" />
        </mxCell>
        <mxCell id="n82" value="Hasta 8 integrantes activos y al menos un administrador por hogar." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontStyle=0;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="470" y="755" width="750" height="21.6" as="geometry" />
        </mxCell>
        <mxCell id="n83" value="LoginAttempt es auxiliar: su email no es una clave foránea a User." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=12;fontStyle=0;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="470" y="777" width="750" height="21.6" as="geometry" />
        </mxCell>
        <mxCell id="n84" value="ref = clave foránea. ? = atributo opcional. No hay relaciones embebidas. PK = clave primaria." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=10;fontStyle=0;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="846" width="1170" height="18.0" as="geometry" />
        </mxCell>
        <mxCell id="n85" value="Las líneas destacan asociaciones principales. Los demás destinos están indicados con ref en los atributos." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=10;fontStyle=0;fontColor=#222222;" vertex="1" parent="1">
          <mxGeometry x="40" y="862" width="1170" height="18.0" as="geometry" />
        </mxCell>
