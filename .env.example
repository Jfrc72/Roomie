# Copiar a .env (npm run dev lo crea solo si no existe). El mismo .env sirve para
# npm run dev y para Docker: cada modo usa solo su sección.

# ── Común ──────────────────────────────────────────────────────────────────────
# Dirección desde la que se abre la app. La API rechaza otros orígenes:
# abrir con localhost, no con 127.0.0.1.
APP_URL=http://localhost:3000

# ── npm run dev ────────────────────────────────────────────────────────────────
# No tocar para usar Docker: Docker ignora estas dos y usa su propia base.
# true: npm run dev inicia y apaga su PostgreSQL en .roomie-data (lo normal).
# false: solo si tienes un PostgreSQL propio; entonces cambia DATABASE_URL.
LOCAL_DATABASE=true
DATABASE_URL=postgresql://roomie:roomie_local@127.0.0.1:54329/roomie

# ── Docker ─────────────────────────────────────────────────────────────────────
# Obligatoria para docker compose. Solo letras y números (va dentro de una URL).
# Se fija al crear la base: si la cambias después, borra los datos con
# docker compose down -v.
POSTGRES_PASSWORD=

# ── Opcional ───────────────────────────────────────────────────────────────────
# Cuentas de prueba, solo para desarrollo (ver README). SEED_DEMO=true las crea al
# iniciar npm run dev; en Docker se crean con un comando y solo usan DEMO_PASSWORD.
SEED_DEMO=false
DEMO_PASSWORD=
# Correo: credenciales propias de un proveedor SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Push: generar con npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
