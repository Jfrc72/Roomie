# Copiar a .env. npm run dev también lo crea para el entorno local.
DATABASE_URL=postgresql://roomie:roomie_local@127.0.0.1:54329/roomie
APP_URL=http://localhost:3000
# false para usar PostgreSQL externo o Docker
LOCAL_DATABASE=true
# Solo Docker: contraseña de PostgreSQL. Usar solo letras y números (va dentro de una URL).
POSTGRES_PASSWORD=
# Datos de demostración: solo locales. Cambia la contraseña si los habilitas.
SEED_DEMO=false
DEMO_PASSWORD=
# Correo opcional: completar con credenciales propias del proveedor SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Push opcional: generar con npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
